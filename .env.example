# Copy this file to .env and fill in the two required API keys.
DOC_ASSISTANT_CHAT_API_KEY=<your-deepseek-api-key>
DOC_ASSISTANT_EMBEDDING_API_KEY=<your-dashscope-api-key>

# Common model overrides
DOC_ASSISTANT_CHAT_MODEL=deepseek-v4-pro
DOC_ASSISTANT_EMBEDDING_MODEL=text-embedding-v3

# Optional integrations
DOC_ASSISTANT_WEB_SEARCH_ENABLED=false
DOC_ASSISTANT_WEB_SEARCH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
