# Copy this file to .env and fill in your real values.
# Generic DOC_ASSISTANT_CHAT_API_KEY is preferred. Legacy DEEPSEEK_API_KEY and
# DASHSCOPE_API_KEY are still recognized as provider-specific fallbacks.
DOC_ASSISTANT_CHAT_API_KEY=<your-deepseek-api-key>
DEEPSEEK_API_KEY=<your-deepseek-api-key>
DASHSCOPE_API_KEY=<your-dashscope-api-key>

# Model settings
DOC_ASSISTANT_CHAT_PROVIDER=deepseek
DOC_ASSISTANT_CHAT_MODEL=deepseek-v4-pro
DOC_ASSISTANT_CHAT_API=compatible
DOC_ASSISTANT_CHAT_BASE_URL=
DOC_ASSISTANT_CHAT_EXTRA_BODY=
DOC_ASSISTANT_LLM_MAX_RETRIES=3
DOC_ASSISTANT_EMBEDDING_PROVIDER=dashscope
DOC_ASSISTANT_EMBEDDING_API_KEY=<your-dashscope-api-key>
DOC_ASSISTANT_EMBEDDING_BASE_URL=
DOC_ASSISTANT_EMBEDDING_MODEL=text-embedding-v3
DOC_ASSISTANT_EMBEDDING_DEVICE=cpu
DOC_ASSISTANT_TEMPERATURE=0
DOC_ASSISTANT_CHAT_HISTORY_WINDOW=12
DOC_ASSISTANT_CHAT_CONTEXT_MAX_TOKENS=32000
DOC_ASSISTANT_CHAT_MAX_OUTPUT_TOKENS=4096
DOC_ASSISTANT_TOOL_CALL_MAX_ITERATIONS=6
DOC_ASSISTANT_TOOL_CALL_HISTORY_WINDOW=12

# Tool calling / web search
# Web search is disabled by default to avoid sending sensitive document text to the public web.
DOC_ASSISTANT_WEB_SEARCH_ENABLED=false
DOC_ASSISTANT_WEB_SEARCH_API_KEY=<your-brave-search-api-key>
DOC_ASSISTANT_WEB_SEARCH_MAX_RESULTS=5
DOC_ASSISTANT_WEB_SEARCH_TIMEOUT_SECONDS=10
DOC_ASSISTANT_WEB_SEARCH_MAX_RETRIES=3

# Read-only Docusign developer MCP connection.
DOC_ASSISTANT_DOCUSIGN_MCP_ENABLED=false
DOC_ASSISTANT_DOCUSIGN_CLIENT_ID=
DOC_ASSISTANT_DOCUSIGN_CLIENT_SECRET=
DOC_ASSISTANT_DOCUSIGN_TOKEN_PATH=data/docusign_mcp_oauth.json

# Retrieval settings
DOC_ASSISTANT_COLLECTION=legal_documents
# Leave URL empty to use the embedded local Qdrant store under data/vector_store.
DOC_ASSISTANT_QDRANT_URL=
DOC_ASSISTANT_QDRANT_API_KEY=
DOC_ASSISTANT_QDRANT_PREFER_GRPC=false
DOC_ASSISTANT_VECTOR_STORE_DIR=
DOC_ASSISTANT_TOP_K=5
DOC_ASSISTANT_RETRIEVAL_MODE=hybrid
DOC_ASSISTANT_RETRIEVAL_FETCH_K=40
DOC_ASSISTANT_RETRIEVAL_MIN_RELEVANCE=0
DOC_ASSISTANT_RETRIEVAL_MMR_LAMBDA=0.85
DOC_ASSISTANT_RETRIEVAL_BM25_K1=1.5
DOC_ASSISTANT_RETRIEVAL_BM25_B=0.75
DOC_ASSISTANT_RETRIEVAL_BM25_AVERAGE_LENGTH=256
DOC_ASSISTANT_RETRIEVAL_CACHE_TTL_SECONDS=300
DOC_ASSISTANT_RETRIEVAL_CACHE_MAX_SIZE=128
DOC_ASSISTANT_QUERY_REWRITE_ENABLED=true
DOC_ASSISTANT_EMBED_BATCH_SIZE=20
DOC_ASSISTANT_EMBED_MAX_WORKERS=4
DOC_ASSISTANT_CHUNK_SIZE=900
DOC_ASSISTANT_CHUNK_OVERLAP=120

DOC_ASSISTANT_INGEST_JOBS_DB_PATH=
DOC_ASSISTANT_AGENT_TASKS_DB_PATH=
DOC_ASSISTANT_PDF_OCR_ENABLED=false
DOC_ASSISTANT_PDF_OCR_LANG=chi_sim+eng
DOC_ASSISTANT_MEMORY_DB_PATH=
DOC_ASSISTANT_MEMORY_COLLECTION=user_memories
DOC_ASSISTANT_MEMORY_TOP_K=5
DOC_ASSISTANT_MEMORY_MIN_CONFIDENCE=0.55
DOC_ASSISTANT_MEMORY_PROMPT_MAX_TOKENS=800

# Registered-user authentication and personal data isolation
DOC_ASSISTANT_AUTH_DB_PATH=data/auth.sqlite3
DOC_ASSISTANT_AUTH_SESSION_TTL_HOURS=168
# Set true behind HTTPS in production.
DOC_ASSISTANT_AUTH_COOKIE_SECURE=false
DOC_ASSISTANT_RATE_LIMIT_ENABLED=true
DOC_ASSISTANT_RATE_LIMIT_MAX_REQUESTS=120
DOC_ASSISTANT_RATE_LIMIT_WINDOW_SECONDS=60
DOC_ASSISTANT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
DOC_ASSISTANT_CORS_ALLOW_CREDENTIALS=true
DOC_ASSISTANT_MAX_UPLOAD_BYTES=20971520
DOC_ASSISTANT_BACKGROUND_MAX_WORKERS=4

# LangSmith tracing and evaluation. Keep false until an API key is configured.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=legal-doc-assistant-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING_SAMPLING_RATE=1.0
